# Public site URL (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://austech.ky

# Contact form delivery through Amazon SES (us-east-2). Without the AWS keys,
# inquiries are logged to the server console instead of emailed.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: SES configuration set name (for bounce/complaint notifications via SNS)
SES_CONFIGURATION_SET=austech-email-set
# Optional: SES tenant name, so suppression and reputation are scoped to this site
SES_TENANT=Austech
INQUIRY_TO=info@austech.ky
INQUIRY_FROM=Austech <website@austech.ky>

# Cloudflare Turnstile on the contact form. Without both keys the form works without it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
